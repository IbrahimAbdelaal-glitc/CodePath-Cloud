// CodePath Cloud — database schema
// DATABASE_URL: connection string used by the app (may be a pooled URL on Neon/Supabase).
// DIRECT_URL:   direct connection used by migrations. Locally the same as DATABASE_URL.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuestionType {
  MULTIPLE_CHOICE
  CODE_OUTPUT
  FILL_IN_THE_BLANK
}

enum ResourceType {
  ARTICLE
  VIDEO
  DOCUMENTATION
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  name             String
  passwordHash     String
  avatarUrl        String?
  role             Role                 @default(STUDENT)
  // Incremented to revoke every issued JWT (password reset or change)
  tokenVersion     Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  userProgress     UserProgress[]
  quizAttempts     QuizAttempt[]
  weaknesses       UserWeakness[]
  bookmarks        Bookmark[]
  assignedRoadmaps RoadmapInstructor[]
  createdRoadmaps  Roadmap[]            @relation("RoadmapCreator")
  resetTokens      PasswordResetToken[]
}

// Single-use password reset tokens. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Roadmap {
  id            String              @id @default(uuid())
  title         String
  slug          String              @unique
  description   String
  summary       String?
  category      String
  difficulty    Difficulty          @default(BEGINNER)
  // Free-text prerequisites for the whole path (e.g. "Basic computer skills")
  prerequisites String[]            @default([])
  isFeatured    Boolean             @default(false)
  isPublished   Boolean             @default(true)
  order         Int                 @default(0)
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     User?               @relation("RoadmapCreator", fields: [createdById], references: [id], onDelete: SetNull)
  modules       Module[]
  instructors   RoadmapInstructor[]
}

// Instructor assignments: instructors manage only the paths assigned to them
model RoadmapInstructor {
  roadmapId  String
  userId     String
  assignedAt DateTime @default(now())
  roadmap    Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roadmapId, userId])
  @@index([userId])
}

model Module {
  id               String               @id @default(uuid())
  roadmapId        String
  title            String
  description      String?
  order            Int
  difficulty       Difficulty           @default(BEGINNER)
  estimatedMinutes Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  roadmap          Roadmap              @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  lessons          Lesson[]
  prerequisites    ModulePrerequisite[] @relation("ModulePrerequisites")
  unlocks          ModulePrerequisite[] @relation("ModuleUnlocks")

  @@unique([roadmapId, order])
}

model ModulePrerequisite {
  moduleId       String
  prerequisiteId String
  module         Module @relation("ModulePrerequisites", fields: [moduleId], references: [id], onDelete: Cascade)
  prerequisite   Module @relation("ModuleUnlocks", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([moduleId, prerequisiteId])
  @@index([prerequisiteId])
}

model Lesson {
  id               String           @id @default(uuid())
  moduleId         String
  title            String
  summary          String?
  // Markdown content (rendered safely, no raw HTML)
  content          String
  keyTakeaways     String[]         @default([])
  order            Int
  difficulty       Difficulty       @default(BEGINNER)
  estimatedMinutes Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes          Quiz[]
  progress         UserProgress[]
  bookmarks        Bookmark[]
  resources        LessonResource[]

  @@unique([moduleId, order])
}

model LessonResource {
  id       String       @id @default(uuid())
  lessonId String
  title    String
  url      String
  type     ResourceType @default(ARTICLE)
  order    Int          @default(0)
  lesson   Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// Topic/skill that questions belong to; weaknesses are measured per topic
model Topic {
  tag        String         @id
  name       String
  quizzes    Quiz[]
  weaknesses UserWeakness[]
}

model Quiz {
  id              String        @id @default(uuid())
  lessonId        String
  question        String
  questionType    QuestionType
  codeSnippet     String?
  options         Json?
  // Never sent to the browser before an attempt
  correctAnswer   String
  // Other accepted answers (for complete-the-code and predict-the-output)
  acceptedAnswers String[]      @default([])
  explanation     String
  topicTag        String
  points          Int           @default(10)
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  lesson          Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic           Topic         @relation(fields: [topicTag], references: [tag], onDelete: Restrict, onUpdate: Cascade)
  attempts        QuizAttempt[]

  @@index([lessonId])
  @@index([topicTag])
}

model UserProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model QuizAttempt {
  id         String   @id @default(uuid())
  userId     String
  quizId     String
  userAnswer String
  isCorrect  Boolean
  score      Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([quizId])
}

model UserWeakness {
  id                 String    @id @default(uuid())
  userId             String
  topicTag           String
  failureCount       Int       @default(1)
  needsReview        Boolean   @default(true)
  // Accuracy (0..1) from the latest answer to each recent question in this topic
  accuracy           Float     @default(0)
  attemptsConsidered Int       @default(0)
  // When the student confirmed reviewing the topic after the weakness was detected
  reviewCompletedAt  DateTime?
  detectedAt         DateTime  @default(now())
  resolvedAt         DateTime?
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic              Topic     @relation(fields: [topicTag], references: [tag], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, topicTag])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}
