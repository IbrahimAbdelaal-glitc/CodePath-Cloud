// CodePath Cloud — database schema
// DATABASE_URL: connection string used by the app (may be a pooled URL on Neon/Supabase).
// DIRECT_URL:   direct connection used by migrations. Locally the same as DATABASE_URL.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuestionType {
  MULTIPLE_CHOICE
  CODE_OUTPUT
  FILL_IN_THE_BLANK
  TRUE_FALSE
  // correctAnswer holds a JSON array of the correct options
  MULTI_SELECT
}

enum ResourceType {
  ARTICLE
  VIDEO
  DOCUMENTATION
}

// LESSON: practice question shown with the lesson. CHECKPOINT: asked during the video at triggerSeconds.
enum QuizPlacement {
  LESSON
  CHECKPOINT
}

enum VideoProvider {
  YOUTUBE
  UPLOAD
}

enum VideoAssetStatus {
  PENDING
  READY
  FAILED
  REPLACED
}

enum ReadingKind {
  PAPER
  REPORT
  STANDARD
  ARTICLE
  BOOK
  DOCUMENTATION
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  name             String
  passwordHash     String
  avatarUrl        String?
  role             Role                 @default(STUDENT)
  // Incremented to revoke every issued JWT (password reset or change)
  tokenVersion     Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  userProgress     UserProgress[]
  quizAttempts     QuizAttempt[]
  weaknesses       UserWeakness[]
  bookmarks        Bookmark[]
  assignedRoadmaps RoadmapInstructor[]
  createdRoadmaps  Roadmap[]            @relation("RoadmapCreator")
  resetTokens      PasswordResetToken[]
  lessonActivity   LessonActivity[]
  certificates     Certificate[]
  videoProgress    LessonVideoProgress[]
  blockAttempts    BlockQuizAttempt[]
  videoUploads     VideoAsset[]
}

// Single-use password reset tokens. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Roadmap {
  id            String              @id @default(uuid())
  title         String
  slug          String              @unique
  description   String
  summary       String?
  category      String
  difficulty    Difficulty          @default(BEGINNER)
  // Free-text prerequisites for the whole path (e.g. "Basic computer skills")
  prerequisites String[]            @default([])
  isFeatured    Boolean             @default(false)
  isPublished   Boolean             @default(true)
  order         Int                 @default(0)
  // Course player: lessons unlock one at a time and each module ends with a block quiz
  isSequential     Boolean          @default(false)
  learningOutcomes String[]         @default([])
  // Attribution for third-party video sources: [{ title, author, url, license }]
  sources          Json             @default("[]")
  // Set on courses created from the built-in catalog; a higher catalog version re-syncs their content
  catalogKey       String?          @unique
  catalogVersion   Int?
  // Score needed on a lesson's in-video questions (latest answer to each) before the lesson completes.
  // Null keeps the original rule: answering every question is enough.
  checkpointPassPercent Int?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     User?               @relation("RoadmapCreator", fields: [createdById], references: [id], onDelete: SetNull)
  modules       Module[]
  instructors   RoadmapInstructor[]
  certificates  Certificate[]
}

// Instructor assignments: instructors manage only the paths assigned to them
model RoadmapInstructor {
  roadmapId  String
  userId     String
  assignedAt DateTime @default(now())
  roadmap    Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roadmapId, userId])
  @@index([userId])
}

model Module {
  id               String               @id @default(uuid())
  roadmapId        String
  title            String
  description      String?
  order            Int
  difficulty       Difficulty           @default(BEGINNER)
  estimatedMinutes Int?
  // Block quiz: how many questions are drawn from the bank per attempt, and the score needed to pass
  quizQuestionCount Int                 @default(10)
  quizPassPercent   Int                 @default(70)
  catalogKey        String?             @unique
  // Experienced students may take the block exam as a skip test (mode TEST_OUT) before doing the lessons
  allowTestOut      Boolean             @default(false)
  // Whole courses a student completes as part of this module (roadmap stages that reuse existing courses)
  linkedRoadmapIds  String[]            @default([])
  // Stage details shown on the course page
  learningOutcomes  String[]            @default([])
  prerequisiteNotes String[]            @default([])
  timeEstimate      String?
  practice          String?
  nextSteps         String?
  // Specialty tracks: [{ key, title, summary, roles, courses: [{ slug, title }], resources: [{ title, url, publisher, access }] }]
  specialties       Json                @default("[]")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  roadmap          Roadmap              @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  lessons          Lesson[]
  prerequisites    ModulePrerequisite[] @relation("ModulePrerequisites")
  unlocks          ModulePrerequisite[] @relation("ModuleUnlocks")
  blockQuestions   BlockQuestion[]
  blockAttempts    BlockQuizAttempt[]
  readings         ModuleReading[]

  @@unique([roadmapId, order])
}

// Further reading listed at the end of a module (papers, reports, standards)
model ModuleReading {
  id         String      @id @default(uuid())
  moduleId   String
  title      String
  authors    String?
  publisher  String?
  year       Int?
  url        String
  kind       ReadingKind @default(ARTICLE)
  note       String?
  // FREE, ACCOUNT (free but needs sign-up) or PAID; null when not stated
  access     String?
  order      Int         @default(0)
  catalogKey String?     @unique
  module     Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

// Question bank for a module's block quiz. Answers never reach the browser before submission.
model BlockQuestion {
  id              String       @id @default(uuid())
  moduleId        String
  question        String
  questionType    QuestionType
  codeSnippet     String?
  options         Json?
  correctAnswer   String
  acceptedAnswers String[]     @default([])
  explanation     String
  topicTag        String?
  // Which lesson the question checks, shown in the review after submission
  lessonTitle     String?
  // True until an instructor confirms the question matches the linked video
  needsReview     Boolean      @default(false)
  // Where the question comes from (e.g. "CS50 lecture notes, Lecture 1")
  sourceNote      String?
  order           Int          @default(0)
  catalogKey      String?      @unique
  createdAt       DateTime     @default(now())
  module          Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

// One sitting of a block quiz: the drawn questions, the answers and the result
model BlockQuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  moduleId    String
  questionIds String[]
  // { [questionId]: answer } after submission
  answers     Json?
  correct     Int       @default(0)
  total       Int
  percent     Int       @default(0)
  passed      Boolean   @default(false)
  // EXAM after the lessons, or TEST_OUT to show prior knowledge and skip them
  mode        String    @default("EXAM")
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([userId, moduleId, startedAt])
  @@index([moduleId])
}

model ModulePrerequisite {
  moduleId       String
  prerequisiteId String
  module         Module @relation("ModulePrerequisites", fields: [moduleId], references: [id], onDelete: Cascade)
  prerequisite   Module @relation("ModuleUnlocks", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([moduleId, prerequisiteId])
  @@index([prerequisiteId])
}

model Lesson {
  id               String           @id @default(uuid())
  moduleId         String
  title            String
  summary          String?
  // Markdown content (rendered safely, no raw HTML)
  content          String
  keyTakeaways     String[]         @default([])
  order            Int
  difficulty       Difficulty       @default(BEGINNER)
  estimatedMinutes Int?
  // Video lesson: a YouTube video (optionally a start/end clip of it) or an uploaded file
  videoProvider        VideoProvider?
  youtubeId            String?
  videoStart           Int?
  videoEnd             Int?
  videoDurationSeconds Int?
  videoAssetId         String?      @unique
  // Attribution for the video shown under the player
  videoCredit          String?
  videoSourceUrl       String?
  catalogKey           String?      @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  videoAsset       VideoAsset?      @relation("LessonVideo", fields: [videoAssetId], references: [id], onDelete: SetNull)
  quizzes          Quiz[]
  progress         UserProgress[]
  bookmarks        Bookmark[]
  resources        LessonResource[]
  activity         LessonActivity[]
  videoProgress    LessonVideoProgress[]
  uploads          VideoAsset[]     @relation("LessonUploads")

  @@unique([moduleId, order])
}

// A video file uploaded by staff to object storage (never to the API server's disk)
model VideoAsset {
  id              String           @id @default(uuid())
  // Object key in the storage bucket
  storageKey      String           @unique
  originalName    String
  contentType     String
  sizeBytes       Int
  durationSeconds Int?
  status          VideoAssetStatus @default(PENDING)
  lessonId        String?
  uploadedById    String?
  createdAt       DateTime         @default(now())
  completedAt     DateTime?
  lesson          Lesson?          @relation("LessonUploads", fields: [lessonId], references: [id], onDelete: SetNull)
  activeFor       Lesson?          @relation("LessonVideo")
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@index([uploadedById])
}

// Where a student is in a lesson video, and which 10-second segments they have actually watched
model LessonVideoProgress {
  id              String    @id @default(uuid())
  userId          String
  lessonId        String
  positionSeconds Int       @default(0)
  watchedSegments Int[]     @default([])
  completedAt     DateTime?
  lastReportAt    DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([userId, updatedAt])
}

model LessonResource {
  id       String       @id @default(uuid())
  lessonId String
  title    String
  url      String
  type     ResourceType @default(ARTICLE)
  order    Int          @default(0)
  lesson   Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// Topic/skill that questions belong to; weaknesses are measured per topic
model Topic {
  tag        String         @id
  name       String
  quizzes    Quiz[]
  weaknesses UserWeakness[]
}

model Quiz {
  id              String        @id @default(uuid())
  lessonId        String
  question        String
  questionType    QuestionType
  codeSnippet     String?
  options         Json?
  // Never sent to the browser before an attempt
  correctAnswer   String
  // Other accepted answers (for complete-the-code and predict-the-output)
  acceptedAnswers String[]      @default([])
  explanation     String
  topicTag        String
  points          Int           @default(10)
  order           Int           @default(0)
  placement       QuizPlacement @default(LESSON)
  // For CHECKPOINT questions: seconds into the lesson video (from the clip start) when the question appears
  triggerSeconds  Int?
  needsReview     Boolean       @default(false)
  sourceNote      String?
  catalogKey      String?       @unique
  createdAt       DateTime      @default(now())
  lesson          Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic           Topic         @relation(fields: [topicTag], references: [tag], onDelete: Restrict, onUpdate: Cascade)
  attempts        QuizAttempt[]

  @@index([lessonId])
  @@index([topicTag])
}

model UserProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model QuizAttempt {
  id         String   @id @default(uuid())
  userId     String
  quizId     String
  userAnswer String
  isCorrect  Boolean
  score      Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([quizId])
}

model UserWeakness {
  id                 String    @id @default(uuid())
  userId             String
  topicTag           String
  failureCount       Int       @default(1)
  needsReview        Boolean   @default(true)
  // Accuracy (0..1) from the latest answer to each recent question in this topic
  accuracy           Float     @default(0)
  attemptsConsidered Int       @default(0)
  // When the student confirmed reviewing the topic after the weakness was detected
  reviewCompletedAt  DateTime?
  detectedAt         DateTime  @default(now())
  resolvedAt         DateTime?
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic              Topic     @relation(fields: [topicTag], references: [tag], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, topicTag])
}

// Active learning time per lesson, credited from heartbeats sent while the lesson page is visible and in use.
// Only the gap between a user's consecutive heartbeats is credited, so idle time and parallel tabs are not counted.
model LessonActivity {
  id              String   @id @default(uuid())
  userId          String
  lessonId        String
  activeSeconds   Int      @default(0)
  firstActiveAt   DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, lastHeartbeatAt])
  @@index([lessonId])
}

// Issued once, when a student first completes every lesson in a path. Values are frozen at issue time.
model Certificate {
  id                String    @id @default(uuid())
  userId            String
  // Kept when the path is deleted; the title below is a snapshot
  roadmapId         String?
  roadmapTitle      String
  completedAt       DateTime
  // Percent from the latest answer to each answered question in the path; null when none was answered
  accuracy          Int?
  questionsAnswered Int
  questionsTotal    Int
  activeSeconds     Int
  // First recorded activity in the path; null when no activity was recorded
  timeTrackedSince  DateTime?
  // False when quiz attempts or lesson completions in the path predate the recorded activity
  timeFullyTracked  Boolean
  // Random public verification code, set only while the student allows public verification.
  // Turning sharing off clears it, which revokes the public link.
  verificationCode  String?   @unique
  issuedAt          DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap           Roadmap?  @relation(fields: [roadmapId], references: [id], onDelete: SetNull)

  @@unique([userId, roadmapId])
  @@index([roadmapId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

// Lease that stops two server instances from syncing the built-in catalog at the same time
model CatalogLock {
  name        String   @id
  owner       String
  lockedUntil DateTime
}
