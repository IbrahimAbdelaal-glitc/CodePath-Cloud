{
  "name": "codepath-cloud-server",
  "version": "1.0.0",
  "private": true,
  "description": "CodePath Cloud API — Express + Prisma + PostgreSQL",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "create-admin": "node scripts/create-admin.js",
    "postinstall": "prisma generate",
    "check:catalog": "node scripts/check-catalog.js",
    "catalog:sync": "node scripts/sync-catalog.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.13",
    "prisma": "6.19.3",
    "zod": "^4.6.7"
  }
}
