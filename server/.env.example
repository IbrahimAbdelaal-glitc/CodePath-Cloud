# ── Database ─────────────────────────────────────────────
# Connection string used by the app.
# Neon: use the "Pooled connection" URL. Supabase: the "Transaction pooler" URL (port 6543) with ?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codepath?schema=public"
# Direct (non-pooled) URL used by prisma migrate. Locally use the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/codepath?schema=public"

# ── Authentication ────────────────────────────────────────────────────
# JWT signing secret: a long random string (at least 32 characters in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# ── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Allowed origins (CORS), comma-separated
CORS_ORIGIN="http://localhost:5173"

# Public URL of the web app; used to build the link in password reset emails
APP_URL="http://localhost:5173"
# How long a password reset link stays valid, in minutes
RESET_TOKEN_MINUTES=30

# ── Email (password reset) ─────────────────────────────────────
# Leave SMTP_HOST empty in local development: emails are then saved as HTML files
# in server/.dev-mail/ instead of being sent (never in production, where SMTP is required).
# Any SMTP provider works (e.g. Resend, Brevo, SendGrid, Mailgun, Gmail with an app password).
SMTP_HOST=""
SMTP_PORT=587
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CodePath Cloud <no-reply@your-domain.com>"

# ── First admin account (npm run create-admin) ─────────────
# Used once; remove them from the environment afterwards
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# ── Optional demo accounts when seeding (npm run db:seed) ──
# If DEMO_PASSWORD is set, seeding creates student@demo.local, instructor@demo.local and admin@demo.local
# These accounts are never created when NODE_ENV=production
DEMO_PASSWORD=""
