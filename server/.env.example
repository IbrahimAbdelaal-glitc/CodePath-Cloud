# ── Database ─────────────────────────────────────────────
# Connection string used by the app.
# Neon: use the "Pooled connection" URL. Supabase: the "Transaction pooler" URL (port 6543) with ?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codepath?schema=public"
# Direct (non-pooled) URL used by prisma migrate. Locally use the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/codepath?schema=public"

# ── Authentication ────────────────────────────────────────────────────
# JWT signing secret: a long random string (at least 32 characters in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# ── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Allowed origins (CORS), comma-separated
CORS_ORIGIN="http://localhost:5173"

# Public URL of the web app; used to build the link in password reset emails
APP_URL="http://localhost:5173"
# How long a password reset link stays valid, in minutes
RESET_TOKEN_MINUTES=30

# ── Email (password reset) ─────────────────────────────────────
# Preferred: an HTTPS email API. Render's free web services block outbound SMTP ports (25/465/587),
# so SMTP cannot deliver from there. Set ONE of these (Resend is checked first):
#   RESEND_API_KEY  from https://resend.com (MAIL_FROM must use a domain verified in Resend)
#   BREVO_API_KEY   from https://brevo.com  (MAIL_FROM must be a sender verified in Brevo)
RESEND_API_KEY=""
BREVO_API_KEY=""
# SMTP fallback for hosts that allow it. Leave everything empty in local development:
# emails are then saved as HTML files in server/.dev-mail/ instead of being sent (never in production).
SMTP_HOST=""
SMTP_PORT=587
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CodePath Cloud <no-reply@your-domain.com>"

# ── Video uploads (S3-compatible object storage) ────────────────
# Uploaded lesson videos go straight from the browser to this bucket; nothing is stored on the API server's disk.
# Neon Object Storage: create a credential with storage:read and storage:write scopes for your branch, then use
# the branch's S3 endpoint (https://<branch-id>.storage.<region>.aws.neon.tech). Cloudflare R2 or AWS S3 also work.
# The bucket is created automatically on first upload, with CORS for CORS_ORIGIN.
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-2"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="lesson-videos"
VIDEO_MAX_MB=1024

# ── Built-in courses ──────────────────────────────────────────────
# On start-up the API creates (or updates, when the catalog version increases) the four cybersecurity courses.
AUTO_SEED_COURSES=true

# ── First admin account (npm run create-admin) ─────────────
# Used once; remove them from the environment afterwards
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# ── Optional demo accounts when seeding (npm run db:seed) ──
# If DEMO_PASSWORD is set, seeding creates student@demo.local, instructor@demo.local and admin@demo.local
# These accounts are never created when NODE_ENV=production
DEMO_PASSWORD=""
